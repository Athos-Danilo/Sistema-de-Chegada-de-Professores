# ==============================================================================
# Variáveis de ambiente necessárias para rodar o Backend localmente e na Vercel.
# Copie este arquivo para ".env" ao testar localmente e preencha os valores reais.
# Nunca envie o arquivo ".env" com senhas reais para o GitHub.
# ==============================================================================

# URL de conexão PostgreSQL gerada no painel da Neon (obrigatório sslmode=require)
DATABASE_URL=postgres://usuario:senha@seu-endpoint.neon.tech/neondb?sslmode=require

# Token secreto do Bot criado no @BotFather do Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# ID do grupo padrão do Telegram usado caso não haja turma específica na grade no momento
TELEGRAM_CHAT_ID_PADRAO=-1001234567890

# Fuso horário oficial para exibição de horários nas notificações
FUSO_HORARIO=America/Recife

# Porta local usada apenas ao rodar "go run ./cmd/servidor" no computador
PORT=8080
